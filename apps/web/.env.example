# Optional override for direct commands run in apps/web.
# Canonical root commands such as `pnpm dev:synthetic` and `pnpm dev:official`
# set this path explicitly and do not require an environment file.
# DREDMORPEDIA_ARTIFACT_DIRECTORY=../../data/generated/official-local
# DREDMORPEDIA_ASSET_DIRECTORY=public/generated-assets/current
# DREDMORPEDIA_ASSET_BASE_PATH=/generated-assets/current
